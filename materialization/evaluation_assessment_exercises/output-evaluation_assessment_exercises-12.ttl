@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:evaluationAssessmentExercise.What%20is%20a%20Knowledge%20Graph%3F.Knowledge%20Graph%20Structure%20Sketch a aplo-ont:EvaluationAssessmentExercise ;
    rdf:value "Knowledge Graph Structure Sketch"^^xsd:string,
        "What is a Knowledge Graph?"^^xsd:string ;
    aplo-ont:evaluatesTopicAwarenessOf currkg-r:topic.Schema,
        currkg-r:topic.Statement,
        currkg-r:topic.Triple ;
    aplo-ont:hasWorkloadLevel aplo-r:workloadLevel.Low%20Workload ;
    aplo-ont:usesTechnique aplo-r:evaluationTechnique.Auto%20Scored%20Concept%20Check .

currkg-r:topic.Schema a currkg:Topic ;
    rdf:value "Schema"^^xsd:string .

currkg-r:topic.Statement a currkg:Topic ;
    rdf:value "Statement"^^xsd:string .

currkg-r:topic.Triple a currkg:Topic ;
    rdf:value "Triple"^^xsd:string .

aplo-r:evaluationTechnique.Auto%20Scored%20Concept%20Check a aplo-ont:EvaluationTechnique ;
    rdf:value "Auto Scored Concept Check"^^xsd:string .

aplo-r:workloadLevel.Low%20Workload a aplo-ont:WorkloadLevel ;
    rdf:value "Low Workload"^^xsd:string .

