@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:evaluationAssessmentExercise.RDF%20Serializations.RDF%20Serialization%20Comparison a aplo-ont:EvaluationAssessmentExercise ;
    rdf:value "RDF Serialization Comparison"^^xsd:string,
        "RDF Serializations"^^xsd:string ;
    aplo-ont:evaluatesTopicAwarenessOf currkg-r:topic.RDF%2FXML ;
    aplo-ont:hasWorkloadLevel aplo-r:workloadLevel.Moderate%20Workload ;
    aplo-ont:usesTechnique aplo-r:evaluationTechnique.Short%20Explanation%20Rubric .

currkg-r:topic.RDF%2FXML a currkg:Topic ;
    rdf:value "RDF/XML"^^xsd:string .

aplo-r:evaluationTechnique.Short%20Explanation%20Rubric a aplo-ont:EvaluationTechnique ;
    rdf:value "Short Explanation Rubric"^^xsd:string .

aplo-r:workloadLevel.Moderate%20Workload a aplo-ont:WorkloadLevel ;
    rdf:value "Moderate Workload"^^xsd:string .

