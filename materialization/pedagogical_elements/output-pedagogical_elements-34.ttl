@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ont#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/res#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:pedagogicalElement.Universal%20Design%20for%20Learning.Engagement%20Options a aplo-ont:PedagogicalElement ;
    aplo-ont:hasDescription "Offer meaningful choices relevance cues or collaboration paths that help learners sustain effort"^^xsd:string ;
    aplo-ont:hasName "Engagement Options"^^xsd:string ;
    aplo-ont:isElementOf aplo-r:pedagogicalFramework.Universal%20Design%20for%20Learning .

aplo-r:pedagogicalFramework.Universal%20Design%20for%20Learning a aplo-ont:PedagogicalFramework ;
    aplo-ont:hasName "Universal Design for Learning"^^xsd:string .

