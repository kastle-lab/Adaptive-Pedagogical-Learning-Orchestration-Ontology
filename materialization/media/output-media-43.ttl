@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

currkg-r:media.GraphQL a currkg:Media ;
    rdf:value "GraphQL"^^xsd:string ;
    aplo-ont:hasAssessmentExercise aplo-r:evaluationAssessmentExercise.GraphQL.GraphQL%20Mapping%20Exercise ;
    aplo-ont:supportsLearningObjective aplo-r:learningObjective.KG%20Resource%20Development%20Practice.Map%20GraphQL%20query%20needs .

aplo-r:evaluationAssessmentExercise.GraphQL.GraphQL%20Mapping%20Exercise a aplo-ont:EvaluationAssessmentExercise ;
    rdf:value "GraphQL Mapping Exercise"^^xsd:string .

aplo-r:learningObjective.KG%20Resource%20Development%20Practice.Map%20GraphQL%20query%20needs a aplo-ont:LearningObjective ;
    aplo-ont:hasName "Map GraphQL query needs"^^xsd:string .

