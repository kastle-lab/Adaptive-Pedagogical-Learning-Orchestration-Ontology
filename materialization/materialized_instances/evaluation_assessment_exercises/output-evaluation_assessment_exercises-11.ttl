@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:evaluationAssessmentExercise.What%20is%20an%20Ontology%3F.Ontology%20Component%20Walkthrough a aplo-ont:EvaluationAssessmentExercise ;
    rdf:value "Ontology Component Walkthrough"^^xsd:string,
        "What is an Ontology?"^^xsd:string ;
    aplo-ont:evaluatesTopicAwarenessOf currkg-r:topic.Linked%20Data,
        currkg-r:topic.Ontology,
        currkg-r:topic.Schema,
        currkg-r:topic.Taxonomy ;
    aplo-ont:hasWorkloadLevel aplo-r:workloadLevel.Moderate%20Workload ;
    aplo-ont:usesTechnique aplo-r:evaluationTechnique.Short%20Explanation%20Rubric .

currkg-r:topic.Linked%20Data a currkg:Topic ;
    rdf:value "Linked Data"^^xsd:string .

currkg-r:topic.Ontology a currkg:Topic ;
    rdf:value "Ontology"^^xsd:string .

currkg-r:topic.Schema a currkg:Topic ;
    rdf:value "Schema"^^xsd:string .

currkg-r:topic.Taxonomy a currkg:Topic ;
    rdf:value "Taxonomy"^^xsd:string .

aplo-r:evaluationTechnique.Short%20Explanation%20Rubric a aplo-ont:EvaluationTechnique ;
    rdf:value "Short Explanation Rubric"^^xsd:string .

aplo-r:workloadLevel.Moderate%20Workload a aplo-ont:WorkloadLevel ;
    rdf:value "Moderate Workload"^^xsd:string .

