@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:evaluationAssessmentExercise.History%20of%20the%20Semantic%20Web.Semantic%20Web%20Timeline%20Explanation a aplo-ont:EvaluationAssessmentExercise ;
    rdf:value "History of the Semantic Web"^^xsd:string,
        "Semantic Web Timeline Explanation"^^xsd:string ;
    aplo-ont:evaluatesTopicAwarenessOf currkg-r:topic.Linked%20Data,
        currkg-r:topic.Ontology,
        currkg-r:topic.Semantic%20Web,
        currkg-r:topic.Taxonomy ;
    aplo-ont:hasWorkloadLevel aplo-r:workloadLevel.Low%20Workload ;
    aplo-ont:usesTechnique aplo-r:evaluationTechnique.Auto%20Scored%20Concept%20Check .

currkg-r:topic.Linked%20Data a currkg:Topic ;
    rdf:value "Linked Data"^^xsd:string .

currkg-r:topic.Ontology a currkg:Topic ;
    rdf:value "Ontology"^^xsd:string .

currkg-r:topic.Semantic%20Web a currkg:Topic ;
    rdf:value "Semantic Web"^^xsd:string .

currkg-r:topic.Taxonomy a currkg:Topic ;
    rdf:value "Taxonomy"^^xsd:string .

aplo-r:evaluationTechnique.Auto%20Scored%20Concept%20Check a aplo-ont:EvaluationTechnique ;
    rdf:value "Auto Scored Concept Check"^^xsd:string .

aplo-r:workloadLevel.Low%20Workload a aplo-ont:WorkloadLevel ;
    rdf:value "Low Workload"^^xsd:string .

