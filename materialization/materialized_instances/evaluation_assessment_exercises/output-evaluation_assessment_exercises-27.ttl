@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:evaluationAssessmentExercise.SPARQL.SPARQL%20Query%20Repair%20Task a aplo-ont:EvaluationAssessmentExercise ;
    rdf:value "SPARQL"^^xsd:string,
        "SPARQL Query Repair Task"^^xsd:string ;
    aplo-ont:evaluatesTopicAwarenessOf currkg-r:topic.Delete,
        currkg-r:topic.Query,
        currkg-r:topic.Select,
        currkg-r:topic.Update ;
    aplo-ont:hasWorkloadLevel aplo-r:workloadLevel.Low%20Workload ;
    aplo-ont:usesTechnique aplo-r:evaluationTechnique.Auto%20Scored%20Concept%20Check .

currkg-r:topic.Delete a currkg:Topic ;
    rdf:value "Delete"^^xsd:string .

currkg-r:topic.Query a currkg:Topic ;
    rdf:value "Query"^^xsd:string .

currkg-r:topic.Select a currkg:Topic ;
    rdf:value "Select"^^xsd:string .

currkg-r:topic.Update a currkg:Topic ;
    rdf:value "Update"^^xsd:string .

aplo-r:evaluationTechnique.Auto%20Scored%20Concept%20Check a aplo-ont:EvaluationTechnique ;
    rdf:value "Auto Scored Concept Check"^^xsd:string .

aplo-r:workloadLevel.Low%20Workload a aplo-ont:WorkloadLevel ;
    rdf:value "Low Workload"^^xsd:string .

