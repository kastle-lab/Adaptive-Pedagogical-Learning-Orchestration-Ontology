@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:evaluationAssessmentExercise.What%20is%20an%20Identifier%3F.Identifier%20Pattern%20Check a aplo-ont:EvaluationAssessmentExercise ;
    rdf:value "Identifier Pattern Check"^^xsd:string,
        "What is an Identifier?"^^xsd:string ;
    aplo-ont:evaluatesTopicAwarenessOf currkg-r:topic.URI ;
    aplo-ont:hasWorkloadLevel aplo-r:workloadLevel.Low%20Workload ;
    aplo-ont:usesTechnique aplo-r:evaluationTechnique.Auto%20Scored%20Concept%20Check .

currkg-r:topic.URI a currkg:Topic ;
    rdf:value "URI"^^xsd:string .

aplo-r:evaluationTechnique.Auto%20Scored%20Concept%20Check a aplo-ont:EvaluationTechnique ;
    rdf:value "Auto Scored Concept Check"^^xsd:string .

aplo-r:workloadLevel.Low%20Workload a aplo-ont:WorkloadLevel ;
    rdf:value "Low Workload"^^xsd:string .

