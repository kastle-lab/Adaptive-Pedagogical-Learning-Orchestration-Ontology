@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:evaluationAssessmentExercise.RDF%20Serializations.Serialization%20Format%20Comparison%20Brief a aplo-ont:EvaluationAssessmentExercise ;
    rdf:value "RDF Serializations"^^xsd:string,
        "Serialization Format Comparison Brief"^^xsd:string ;
    aplo-ont:evaluatesTopicAwarenessOf currkg-r:topic.JSON-LD,
        currkg-r:topic.RDF%2FXML,
        currkg-r:topic.Turtle ;
    aplo-ont:hasWorkloadLevel aplo-r:workloadLevel.Low%20Workload ;
    aplo-ont:usesTechnique aplo-r:evaluationTechnique.Auto%20Scored%20Concept%20Check .

currkg-r:topic.JSON-LD a currkg:Topic ;
    rdf:value "JSON-LD"^^xsd:string .

currkg-r:topic.RDF%2FXML a currkg:Topic ;
    rdf:value "RDF/XML"^^xsd:string .

currkg-r:topic.Turtle a currkg:Topic ;
    rdf:value "Turtle"^^xsd:string .

aplo-r:evaluationTechnique.Auto%20Scored%20Concept%20Check a aplo-ont:EvaluationTechnique ;
    rdf:value "Auto Scored Concept Check"^^xsd:string .

aplo-r:workloadLevel.Low%20Workload a aplo-ont:WorkloadLevel ;
    rdf:value "Low Workload"^^xsd:string .

