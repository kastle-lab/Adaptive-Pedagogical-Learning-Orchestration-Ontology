@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:evaluationAssessmentExercise.RDFS.RDFS%20Vocabulary%20Inference%20Review a aplo-ont:EvaluationAssessmentExercise ;
    rdf:value "RDFS"^^xsd:string,
        "RDFS Vocabulary Inference Review"^^xsd:string ;
    aplo-ont:evaluatesTopicAwarenessOf currkg-r:topic.Domain%20Restrictions,
        currkg-r:topic.Range%20Restrictions,
        currkg-r:topic.Subclass,
        currkg-r:topic.Subproperty ;
    aplo-ont:hasWorkloadLevel aplo-r:workloadLevel.Low%20Workload ;
    aplo-ont:usesTechnique aplo-r:evaluationTechnique.Auto%20Scored%20Concept%20Check .

currkg-r:topic.Domain%20Restrictions a currkg:Topic ;
    rdf:value "Domain Restrictions"^^xsd:string .

currkg-r:topic.Range%20Restrictions a currkg:Topic ;
    rdf:value "Range Restrictions"^^xsd:string .

currkg-r:topic.Subclass a currkg:Topic ;
    rdf:value "Subclass"^^xsd:string .

currkg-r:topic.Subproperty a currkg:Topic ;
    rdf:value "Subproperty"^^xsd:string .

aplo-r:evaluationTechnique.Auto%20Scored%20Concept%20Check a aplo-ont:EvaluationTechnique ;
    rdf:value "Auto Scored Concept Check"^^xsd:string .

aplo-r:workloadLevel.Low%20Workload a aplo-ont:WorkloadLevel ;
    rdf:value "Low Workload"^^xsd:string .

