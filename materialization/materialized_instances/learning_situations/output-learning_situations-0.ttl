@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:learningSituation.Foundational%20Semantic%20Web%20Study a aplo-ont:LearningSituation ;
    rdf:value "Foundational Semantic Web Study"^^xsd:string ;
    aplo-ont:requiresTopicKnowledge currkg-r:topic.Knowledge%20Graph,
        currkg-r:topic.Metadata ;
    aplo-ont:scopes currkg-r:persona.Ethan .

currkg-r:persona.Ethan a currkg:Persona ;
    rdf:value "Ethan"^^xsd:string .

currkg-r:topic.Knowledge%20Graph a currkg:Topic ;
    rdf:value "Knowledge Graph"^^xsd:string .

currkg-r:topic.Metadata a currkg:Topic ;
    rdf:value "Metadata"^^xsd:string .

