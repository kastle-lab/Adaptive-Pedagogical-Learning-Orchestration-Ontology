@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:learningSituation.Developer%20Knowledge%20Graph%20Implementation%20Practice a aplo-ont:LearningSituation ;
    rdf:value "Developer Knowledge Graph Implementation Practice"^^xsd:string ;
    aplo-ont:requiresTopicKnowledge currkg-r:topic.Namespace,
        currkg-r:topic.Query,
        currkg-r:topic.Triple,
        currkg-r:topic.URI ;
    aplo-ont:scopes currkg-r:persona.Stella .

currkg-r:persona.Stella a currkg:Persona ;
    rdf:value "Stella"^^xsd:string .

currkg-r:topic.Namespace a currkg:Topic ;
    rdf:value "Namespace"^^xsd:string .

currkg-r:topic.Query a currkg:Topic ;
    rdf:value "Query"^^xsd:string .

currkg-r:topic.Triple a currkg:Topic ;
    rdf:value "Triple"^^xsd:string .

currkg-r:topic.URI a currkg:Topic ;
    rdf:value "URI"^^xsd:string .

