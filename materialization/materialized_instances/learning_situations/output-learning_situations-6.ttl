@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:learningSituation.OWL%20Modeling%20Practice a aplo-ont:LearningSituation ;
    rdf:value "OWL Modeling Practice"^^xsd:string ;
    aplo-ont:requiresTopicKnowledge currkg-r:topic.Axiom,
        currkg-r:topic.OWL,
        currkg-r:topic.Property ;
    aplo-ont:scopes currkg-r:persona.Oratius .

currkg-r:persona.Oratius a currkg:Persona ;
    rdf:value "Oratius"^^xsd:string .

currkg-r:topic.Axiom a currkg:Topic ;
    rdf:value "Axiom"^^xsd:string .

currkg-r:topic.OWL a currkg:Topic ;
    rdf:value "OWL"^^xsd:string .

currkg-r:topic.Property a currkg:Topic ;
    rdf:value "Property"^^xsd:string .

