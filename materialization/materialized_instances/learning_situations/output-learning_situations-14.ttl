@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:learningSituation.Consulting%20KG%20Opportunity%20Review a aplo-ont:LearningSituation ;
    rdf:value "Consulting KG Opportunity Review"^^xsd:string ;
    aplo-ont:requiresTopicKnowledge currkg-r:topic.Graph,
        currkg-r:topic.Knowledge%20Graph ;
    aplo-ont:scopes currkg-r:persona.Chris .

currkg-r:persona.Chris a currkg:Persona ;
    rdf:value "Chris"^^xsd:string .

currkg-r:topic.Graph a currkg:Topic ;
    rdf:value "Graph"^^xsd:string .

currkg-r:topic.Knowledge%20Graph a currkg:Topic ;
    rdf:value "Knowledge Graph"^^xsd:string .

