@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:learningSituation.Executive%20KG%20Outcome%20Framing a aplo-ont:LearningSituation ;
    rdf:value "Executive KG Outcome Framing"^^xsd:string ;
    aplo-ont:requiresTopicKnowledge currkg-r:topic.Explain ;
    aplo-ont:scopes currkg-r:persona.Ella .

currkg-r:persona.Ella a currkg:Persona ;
    rdf:value "Ella"^^xsd:string .

currkg-r:topic.Explain a currkg:Topic ;
    rdf:value "Explain"^^xsd:string .

