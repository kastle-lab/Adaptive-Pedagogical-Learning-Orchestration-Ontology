@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:skill.Logic%20Operator%20Recognition a aplo-ont:Skill ;
    rdf:value "Logic Operator Recognition"^^xsd:string ;
    aplo-ont:requiresTopic currkg-r:topic.Boolean%20Arithmetic,
        currkg-r:topic.Conjunction,
        currkg-r:topic.Disjunction .

currkg-r:topic.Boolean%20Arithmetic a currkg:Topic ;
    rdf:value "Boolean Arithmetic"^^xsd:string .

currkg-r:topic.Conjunction a currkg:Topic ;
    rdf:value "Conjunction"^^xsd:string .

currkg-r:topic.Disjunction a currkg:Topic ;
    rdf:value "Disjunction"^^xsd:string .

