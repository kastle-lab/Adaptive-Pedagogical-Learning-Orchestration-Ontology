@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:skill.Rule%20Based%20Inference%20Explanation a aplo-ont:Skill ;
    rdf:value "Rule Based Inference Explanation"^^xsd:string ;
    aplo-ont:requiresTopic currkg-r:topic.Inference .

currkg-r:topic.Inference a currkg:Topic ;
    rdf:value "Inference"^^xsd:string .

