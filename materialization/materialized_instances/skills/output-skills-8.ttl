@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:skill.OWL%20Property%20Differentiation a aplo-ont:Skill ;
    rdf:value "OWL Property Differentiation"^^xsd:string ;
    aplo-ont:requiresTopic currkg-r:topic.Data%20Properties,
        currkg-r:topic.OWL,
        currkg-r:topic.Object%20Properties .

currkg-r:topic.Data%20Properties a currkg:Topic ;
    rdf:value "Data Properties"^^xsd:string .

currkg-r:topic.OWL a currkg:Topic ;
    rdf:value "OWL"^^xsd:string .

currkg-r:topic.Object%20Properties a currkg:Topic ;
    rdf:value "Object Properties"^^xsd:string .

