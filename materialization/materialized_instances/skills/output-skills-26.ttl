@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:skill.RDFS%20Vocabulary%20Reasoning a aplo-ont:Skill ;
    rdf:value "RDFS Vocabulary Reasoning"^^xsd:string ;
    aplo-ont:requiresTopic currkg-r:topic.Domain%20Restrictions,
        currkg-r:topic.Range%20Restrictions,
        currkg-r:topic.Subclass,
        currkg-r:topic.Subproperty .

currkg-r:topic.Domain%20Restrictions a currkg:Topic ;
    rdf:value "Domain Restrictions"^^xsd:string .

currkg-r:topic.Range%20Restrictions a currkg:Topic ;
    rdf:value "Range Restrictions"^^xsd:string .

currkg-r:topic.Subclass a currkg:Topic ;
    rdf:value "Subclass"^^xsd:string .

currkg-r:topic.Subproperty a currkg:Topic ;
    rdf:value "Subproperty"^^xsd:string .

