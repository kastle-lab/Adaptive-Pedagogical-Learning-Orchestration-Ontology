@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:skill.RDF%20Graph%20Interpretation a aplo-ont:Skill ;
    rdf:value "RDF Graph Interpretation"^^xsd:string ;
    aplo-ont:requiresTopic currkg-r:topic.Blank%20Node,
        currkg-r:topic.Blank%20Nodes,
        currkg-r:topic.Class,
        currkg-r:topic.Literals,
        currkg-r:topic.Namespace,
        currkg-r:topic.Namespaces,
        currkg-r:topic.Object,
        currkg-r:topic.Predicate,
        currkg-r:topic.Property,
        currkg-r:topic.Subject,
        currkg-r:topic.Triple,
        currkg-r:topic.Type .

currkg-r:topic.Blank%20Node a currkg:Topic ;
    rdf:value "Blank Node"^^xsd:string .

currkg-r:topic.Blank%20Nodes a currkg:Topic ;
    rdf:value "Blank Nodes"^^xsd:string .

currkg-r:topic.Class a currkg:Topic ;
    rdf:value "Class"^^xsd:string .

currkg-r:topic.Literals a currkg:Topic ;
    rdf:value "Literals"^^xsd:string .

currkg-r:topic.Namespace a currkg:Topic ;
    rdf:value "Namespace"^^xsd:string .

currkg-r:topic.Namespaces a currkg:Topic ;
    rdf:value "Namespaces"^^xsd:string .

currkg-r:topic.Object a currkg:Topic ;
    rdf:value "Object"^^xsd:string .

currkg-r:topic.Predicate a currkg:Topic ;
    rdf:value "Predicate"^^xsd:string .

currkg-r:topic.Property a currkg:Topic ;
    rdf:value "Property"^^xsd:string .

currkg-r:topic.Subject a currkg:Topic ;
    rdf:value "Subject"^^xsd:string .

currkg-r:topic.Triple a currkg:Topic ;
    rdf:value "Triple"^^xsd:string .

currkg-r:topic.Type a currkg:Topic ;
    rdf:value "Type"^^xsd:string .

