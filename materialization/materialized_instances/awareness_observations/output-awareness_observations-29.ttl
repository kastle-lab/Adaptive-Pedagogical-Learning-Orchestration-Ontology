@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:learner.Learner%20Kai a aplo-ont:Learner ;
    rdf:value "Learner Kai"^^xsd:string ;
    aplo-ont:hasAwarenessObservation aplo-r:awarenessObservation.Learner%20Kai.OWL.OWL%20Modeling%20Constraint%20Analysis.OWL%20Modeling%20Constraint%20Analysis%20Scenario%20Update .

aplo-r:awarenessLevel.Basic%20Awareness a aplo-ont:AwarenessLevel ;
    rdf:value "Basic Awareness"^^xsd:string .

aplo-r:awarenessObservation.Learner%20Kai.OWL.OWL%20Modeling%20Constraint%20Analysis.OWL%20Modeling%20Constraint%20Analysis%20Scenario%20Update a aplo-ont:AwarenessObservation ;
    rdf:value "OWL Modeling Constraint Analysis Scenario Update"^^xsd:string ;
    aplo-ont:atTime aplo-r:temporalExtent.Learner%20Kai.OWL.OWL%20Modeling%20Constraint%20Analysis.OWL%20Modeling%20Constraint%20Analysis%20Scenario%20Update.2026-02-20T14%3A03%3A00Z%20to%202026-02-20T14%3A28%3A00Z ;
    aplo-ont:hasAwarenessLevel aplo-r:awarenessLevel.Basic%20Awareness ;
    aplo-ont:onSkill aplo-r:skill.OWL%20Modeling%20Constraint%20Analysis ;
    aplo-ont:onTopic currkg-r:topic.OWL .

aplo-r:skill.OWL%20Modeling%20Constraint%20Analysis a aplo-ont:Skill ;
    rdf:value "OWL Modeling Constraint Analysis"^^xsd:string .

aplo-r:temporalExtent.Learner%20Kai.OWL.OWL%20Modeling%20Constraint%20Analysis.OWL%20Modeling%20Constraint%20Analysis%20Scenario%20Update.2026-02-20T14%3A03%3A00Z%20to%202026-02-20T14%3A28%3A00Z a aplo-ont:TemporalExtent ;
    rdf:value "2026-02-20T14:03:00+00:00"^^xsd:dateTime,
        "2026-02-20T14:28:00+00:00"^^xsd:dateTime,
        "ISO 8601 UTC"^^xsd:string,
        "TimeInterval"^^xsd:string .

currkg-r:topic.OWL a currkg:Topic ;
    rdf:value "OWL"^^xsd:string .

