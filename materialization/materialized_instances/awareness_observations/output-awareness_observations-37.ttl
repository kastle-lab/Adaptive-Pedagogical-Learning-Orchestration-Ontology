@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:learner.Learner%20Oratius a aplo-ont:Learner ;
    rdf:value "Learner Oratius"^^xsd:string ;
    aplo-ont:hasAwarenessObservation aplo-r:awarenessObservation.Learner%20Oratius.Taxonomy.SKOS%20Concept%20Scheme%20Modeling.SKOS%20Concept%20Scheme%20Modeling%20Scenario%20Update .

aplo-r:awarenessLevel.Proficient%20Awareness a aplo-ont:AwarenessLevel ;
    rdf:value "Proficient Awareness"^^xsd:string .

aplo-r:awarenessObservation.Learner%20Oratius.Taxonomy.SKOS%20Concept%20Scheme%20Modeling.SKOS%20Concept%20Scheme%20Modeling%20Scenario%20Update a aplo-ont:AwarenessObservation ;
    rdf:value "SKOS Concept Scheme Modeling Scenario Update"^^xsd:string ;
    aplo-ont:atTime aplo-r:temporalExtent.Learner%20Oratius.Taxonomy.SKOS%20Concept%20Scheme%20Modeling.SKOS%20Concept%20Scheme%20Modeling%20Scenario%20Update.2026-02-28T13%3A49%3A00Z%20to%202026-02-28T14%3A14%3A00Z ;
    aplo-ont:hasAwarenessLevel aplo-r:awarenessLevel.Proficient%20Awareness ;
    aplo-ont:onSkill aplo-r:skill.SKOS%20Concept%20Scheme%20Modeling ;
    aplo-ont:onTopic currkg-r:topic.Taxonomy .

aplo-r:skill.SKOS%20Concept%20Scheme%20Modeling a aplo-ont:Skill ;
    rdf:value "SKOS Concept Scheme Modeling"^^xsd:string .

aplo-r:temporalExtent.Learner%20Oratius.Taxonomy.SKOS%20Concept%20Scheme%20Modeling.SKOS%20Concept%20Scheme%20Modeling%20Scenario%20Update.2026-02-28T13%3A49%3A00Z%20to%202026-02-28T14%3A14%3A00Z a aplo-ont:TemporalExtent ;
    rdf:value "2026-02-28T13:49:00+00:00"^^xsd:dateTime,
        "2026-02-28T14:14:00+00:00"^^xsd:dateTime,
        "ISO 8601 UTC"^^xsd:string,
        "TimeInterval"^^xsd:string .

currkg-r:topic.Taxonomy a currkg:Topic ;
    rdf:value "Taxonomy"^^xsd:string .

