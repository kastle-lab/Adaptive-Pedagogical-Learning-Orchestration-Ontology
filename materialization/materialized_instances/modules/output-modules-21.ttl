@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

currkg-r:module.Datalog a currkg:Module ;
    rdf:value "Datalog"^^xsd:string ;
    aplo-ont:hasAssessmentExercise aplo-r:evaluationAssessmentExercise.Datalog.Datalog%20Rule%20Trace ;
    aplo-ont:hasLearningObjective aplo-r:learningObjective.Data%20Analysis%20KG%20Modeling%20Practice.Interpret%20Datalog%20rules .

aplo-r:evaluationAssessmentExercise.Datalog.Datalog%20Rule%20Trace a aplo-ont:EvaluationAssessmentExercise ;
    rdf:value "Datalog Rule Trace"^^xsd:string .

aplo-r:learningObjective.Data%20Analysis%20KG%20Modeling%20Practice.Interpret%20Datalog%20rules a aplo-ont:LearningObjective ;
    aplo-ont:hasName "Interpret Datalog rules"^^xsd:string .

