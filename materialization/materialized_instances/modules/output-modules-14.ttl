@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

currkg-r:module.SPARQL a currkg:Module ;
    rdf:value "SPARQL"^^xsd:string ;
    aplo-ont:hasAssessmentExercise aplo-r:evaluationAssessmentExercise.SPARQL.SPARQL%20Select%20Query%20Exercise ;
    aplo-ont:hasLearningObjective aplo-r:learningObjective.SPARQL%20Query%20Practice.Construct%20a%20basic%20SPARQL%20SELECT%20query .

aplo-r:evaluationAssessmentExercise.SPARQL.SPARQL%20Select%20Query%20Exercise a aplo-ont:EvaluationAssessmentExercise ;
    rdf:value "SPARQL Select Query Exercise"^^xsd:string .

aplo-r:learningObjective.SPARQL%20Query%20Practice.Construct%20a%20basic%20SPARQL%20SELECT%20query a aplo-ont:LearningObjective ;
    aplo-ont:hasName "Construct a basic SPARQL SELECT query"^^xsd:string .

