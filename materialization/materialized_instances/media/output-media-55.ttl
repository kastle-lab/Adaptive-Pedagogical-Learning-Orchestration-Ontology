@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

currkg-r:media.Open%20Graph%20Protocol a currkg:Media ;
    rdf:value "Open Graph Protocol"^^xsd:string ;
    aplo-ont:hasAssessmentExercise aplo-r:evaluationAssessmentExercise.Open%20Graph%20Protocol.Open%20Graph%20Metadata%20Audit ;
    aplo-ont:supportsLearningObjective aplo-r:learningObjective.Consulting%20KG%20Opportunity%20Review.Map%20Open%20Graph%20metadata .

aplo-r:evaluationAssessmentExercise.Open%20Graph%20Protocol.Open%20Graph%20Metadata%20Audit a aplo-ont:EvaluationAssessmentExercise ;
    rdf:value "Open Graph Metadata Audit"^^xsd:string .

aplo-r:learningObjective.Consulting%20KG%20Opportunity%20Review.Map%20Open%20Graph%20metadata a aplo-ont:LearningObjective ;
    aplo-ont:hasName "Map Open Graph metadata"^^xsd:string .

