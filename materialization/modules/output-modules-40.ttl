@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

currkg-r:module.Deploying%20a%20Knowledge%20Graph a currkg:Module ;
    rdf:value "Deploying a Knowledge Graph"^^xsd:string ;
    aplo-ont:hasAssessmentExercise aplo-r:evaluationAssessmentExercise.Deploying%20a%20Knowledge%20Graph.KG%20Deployment%20Readiness%20Review ;
    aplo-ont:hasLearningObjective aplo-r:learningObjective.Ontology%20Contribution%20Modeling%20Practice.Plan%20knowledge%20graph%20deployment .

aplo-r:evaluationAssessmentExercise.Deploying%20a%20Knowledge%20Graph.KG%20Deployment%20Readiness%20Review a aplo-ont:EvaluationAssessmentExercise ;
    rdf:value "KG Deployment Readiness Review"^^xsd:string .

aplo-r:learningObjective.Ontology%20Contribution%20Modeling%20Practice.Plan%20knowledge%20graph%20deployment a aplo-ont:LearningObjective ;
    aplo-ont:hasName "Plan knowledge graph deployment"^^xsd:string .

