@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:learningSituation.SPARQL%20Query%20Practice a aplo-ont:LearningSituation ;
    rdf:value "SPARQL Query Practice"^^xsd:string ;
    aplo-ont:requiresTopicKnowledge currkg-r:topic.Query,
        currkg-r:topic.Triple ;
    aplo-ont:scopes currkg-r:persona.Debbie .

currkg-r:persona.Debbie a currkg:Persona ;
    rdf:value "Debbie"^^xsd:string .

currkg-r:topic.Query a currkg:Topic ;
    rdf:value "Query"^^xsd:string .

currkg-r:topic.Triple a currkg:Topic ;
    rdf:value "Triple"^^xsd:string .

