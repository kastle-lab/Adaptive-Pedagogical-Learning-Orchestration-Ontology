@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:learningSituation.Educational%20KG%20Facilitation%20Planning a aplo-ont:LearningSituation ;
    rdf:value "Educational KG Facilitation Planning"^^xsd:string ;
    aplo-ont:requiresTopicKnowledge currkg-r:topic.Graph,
        currkg-r:topic.Knowledge%20Graph,
        currkg-r:topic.OWL,
        currkg-r:topic.Ontology,
        currkg-r:topic.Schema ;
    aplo-ont:scopes currkg-r:persona.Elias .

currkg-r:persona.Elias a currkg:Persona ;
    rdf:value "Elias"^^xsd:string .

currkg-r:topic.Graph a currkg:Topic ;
    rdf:value "Graph"^^xsd:string .

currkg-r:topic.Knowledge%20Graph a currkg:Topic ;
    rdf:value "Knowledge Graph"^^xsd:string .

currkg-r:topic.OWL a currkg:Topic ;
    rdf:value "OWL"^^xsd:string .

currkg-r:topic.Ontology a currkg:Topic ;
    rdf:value "Ontology"^^xsd:string .

currkg-r:topic.Schema a currkg:Topic ;
    rdf:value "Schema"^^xsd:string .

