@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:learningSituation.KG%20Research%20Representation%20Study a aplo-ont:LearningSituation ;
    rdf:value "KG Research Representation Study"^^xsd:string ;
    aplo-ont:requiresTopicKnowledge currkg-r:topic.Knowledge%20Graph ;
    aplo-ont:scopes currkg-r:persona.Kai .

currkg-r:persona.Kai a currkg:Persona ;
    rdf:value "Kai"^^xsd:string .

currkg-r:topic.Knowledge%20Graph a currkg:Topic ;
    rdf:value "Knowledge Graph"^^xsd:string .

