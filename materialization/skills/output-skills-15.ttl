@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:skill.Identifier%20Pattern%20Recognition a aplo-ont:Skill ;
    rdf:value "Identifier Pattern Recognition"^^xsd:string ;
    aplo-ont:requiresTopic currkg-r:topic.Hash%20or%20Slash,
        currkg-r:topic.Namespace,
        currkg-r:topic.URI .

currkg-r:topic.Hash%20or%20Slash a currkg:Topic ;
    rdf:value "Hash or Slash"^^xsd:string .

currkg-r:topic.Namespace a currkg:Topic ;
    rdf:value "Namespace"^^xsd:string .

currkg-r:topic.URI a currkg:Topic ;
    rdf:value "URI"^^xsd:string .

