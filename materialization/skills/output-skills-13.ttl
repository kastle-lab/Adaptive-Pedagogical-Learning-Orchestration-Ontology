@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:skill.Ontology%20Component%20Explanation a aplo-ont:Skill ;
    rdf:value "Ontology Component Explanation"^^xsd:string ;
    aplo-ont:requiresTopic currkg-r:topic.Linked%20Data,
        currkg-r:topic.Ontology,
        currkg-r:topic.Schema,
        currkg-r:topic.Statement,
        currkg-r:topic.Taxonomy,
        currkg-r:topic.Triple .

currkg-r:topic.Linked%20Data a currkg:Topic ;
    rdf:value "Linked Data"^^xsd:string .

currkg-r:topic.Ontology a currkg:Topic ;
    rdf:value "Ontology"^^xsd:string .

currkg-r:topic.Schema a currkg:Topic ;
    rdf:value "Schema"^^xsd:string .

currkg-r:topic.Statement a currkg:Topic ;
    rdf:value "Statement"^^xsd:string .

currkg-r:topic.Taxonomy a currkg:Topic ;
    rdf:value "Taxonomy"^^xsd:string .

currkg-r:topic.Triple a currkg:Topic ;
    rdf:value "Triple"^^xsd:string .

