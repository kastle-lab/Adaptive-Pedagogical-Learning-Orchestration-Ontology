@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:skill.Upper%20Ontology%20Alignment a aplo-ont:Skill ;
    rdf:value "Upper Ontology Alignment"^^xsd:string ;
    aplo-ont:requiresTopic currkg-r:topic.Ontology .

currkg-r:topic.Ontology a currkg:Topic ;
    rdf:value "Ontology"^^xsd:string .

