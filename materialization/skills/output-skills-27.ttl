@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:skill.RDF%20Serialization%20Format%20Comparison a aplo-ont:Skill ;
    rdf:value "RDF Serialization Format Comparison"^^xsd:string ;
    aplo-ont:requiresTopic currkg-r:topic.JSON-LD,
        currkg-r:topic.RDF%2FXML,
        currkg-r:topic.Turtle .

currkg-r:topic.JSON-LD a currkg:Topic ;
    rdf:value "JSON-LD"^^xsd:string .

currkg-r:topic.RDF%2FXML a currkg:Topic ;
    rdf:value "RDF/XML"^^xsd:string .

currkg-r:topic.Turtle a currkg:Topic ;
    rdf:value "Turtle"^^xsd:string .

