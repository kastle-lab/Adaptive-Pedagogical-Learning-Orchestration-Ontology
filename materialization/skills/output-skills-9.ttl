@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:skill.OWL%20Axiom%20Analysis a aplo-ont:Skill ;
    rdf:value "OWL Axiom Analysis"^^xsd:string ;
    aplo-ont:requiresTopic currkg-r:topic.Axiom,
        currkg-r:topic.Cardinality,
        currkg-r:topic.Disjointness,
        currkg-r:topic.Equivalence,
        currkg-r:topic.OWL .

currkg-r:topic.Axiom a currkg:Topic ;
    rdf:value "Axiom"^^xsd:string .

currkg-r:topic.Cardinality a currkg:Topic ;
    rdf:value "Cardinality"^^xsd:string .

currkg-r:topic.Disjointness a currkg:Topic ;
    rdf:value "Disjointness"^^xsd:string .

currkg-r:topic.Equivalence a currkg:Topic ;
    rdf:value "Equivalence"^^xsd:string .

currkg-r:topic.OWL a currkg:Topic ;
    rdf:value "OWL"^^xsd:string .

