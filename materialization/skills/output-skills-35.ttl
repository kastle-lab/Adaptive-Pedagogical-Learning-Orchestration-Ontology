@prefix aplo-ont: <https://kastle-lab.org/aplo/lod/ontology#> .
@prefix aplo-r: <https://kastle-lab.org/aplo/lod/resource#> .
@prefix currkg: <https://kastle-lab.org/currkg/lod/ontology#> .
@prefix currkg-r: <https://kastle-lab.org/currkg/lod/resource#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aplo-r:skill.Schema.org%20Vocabulary%20Alignment a aplo-ont:Skill ;
    rdf:value "Schema.org Vocabulary Alignment"^^xsd:string ;
    aplo-ont:requiresTopic currkg-r:topic.domainIncludes,
        currkg-r:topic.rangeIncludes .

currkg-r:topic.domainIncludes a currkg:Topic ;
    rdf:value "domainIncludes"^^xsd:string .

currkg-r:topic.rangeIncludes a currkg:Topic ;
    rdf:value "rangeIncludes"^^xsd:string .

