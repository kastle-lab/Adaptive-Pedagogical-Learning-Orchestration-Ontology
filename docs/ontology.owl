    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Provides an optional textual description for a learning objective or learning strategy.</rdfs:comment>
    <rdfs:comment>Provides an optional textual description for a pedagogical element, framework, objective, or technique.</rdfs:comment>
    <rdfs:label>hasDescription</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://kastle-lab.org/aplo/lod/ontology#Source">
