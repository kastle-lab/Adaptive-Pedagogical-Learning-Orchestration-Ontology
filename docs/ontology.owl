  </rdf:Description>
  <rdf:Description rdf:about="https://kastle-lab.org/aplo/lod/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
    <rdfs:comment>Full ontology containing the evaluation, learner model, learning objective, and pedagogical framework patterns for autonomous learning orchestration.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://kastle-lab.org/aplo/lod/ontology#AwarenessLevel">
